---
import { photos } from "../data/photos";
import { MapPin } from "phosphor-react";

const count = photos.length;
/** Tall-left mosaic fills a 2×3 rectangle with no leftover cells. */
const layoutClass = count === 5 ? "is-mosaic-5" : "is-uniform";
---

{
  photos.length > 0 ? (
    <section class="photo-gallery" aria-label="Photos">
      <h2 class="photo-gallery-heading">Photos</h2>
      <ul class={`photo-gallery-masonry ${layoutClass}`}>
        {photos.map((photo) => (
          <li class="photo-tile">
            <button
              type="button"
              class="photo-tile-btn"
              aria-label={`${photo.alt}. ${photo.description}. ${photo.location}.`}
            >
              <img src={photo.src} alt={photo.alt} loading="lazy" />
              <span class="photo-tile-overlay">
                <span class="photo-tile-description">{photo.description}</span>
                <span class="photo-tile-location">
                  <MapPin size={14} weight="fill" />
                  {photo.location}
                </span>
              </span>
            </button>
          </li>
        ))}
      </ul>
    </section>
  ) : null
}

<style>
  .photo-gallery {
    margin-top: 3rem;
    padding-top: 0.5rem;
  }

  .photo-gallery-heading {
    margin: 0 0 1.25rem;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #2e3440; /* nord0 */
  }

  :global(html.dark) .photo-gallery-heading {
    color: #eceff4; /* nord6 */
  }

  .photo-gallery-masonry {
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.75rem;
  }

  /* Filled mosaic: one tall tile + four cells → complete 2×3 block */
  .photo-gallery-masonry.is-mosaic-5 {
    display: grid;
    grid-template-columns: 1.15fr 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    height: clamp(22rem, 48vw, 34rem);
  }

  .photo-gallery-masonry.is-mosaic-5 .photo-tile:first-child {
    grid-row: span 2;
  }

  @media (max-width: 699px) {
    .photo-gallery-masonry.is-mosaic-5 {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: repeat(3, 1fr);
      height: clamp(28rem, 120vw, 40rem);
    }

    .photo-gallery-masonry.is-mosaic-5 .photo-tile:first-child {
      grid-column: span 2;
      grid-row: span 1;
    }
  }

  /* Other counts: flex so the last row grows and fills width */
  .photo-gallery-masonry.is-uniform {
    display: flex;
    flex-wrap: wrap;
  }

  .photo-gallery-masonry.is-uniform .photo-tile {
    flex: 1 1 16rem;
    aspect-ratio: 4 / 3;
    min-height: 11rem;
  }

  .photo-tile {
    min-height: 0;
    min-width: 0;
  }

  .photo-tile-btn {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: #d8dee9; /* nord5 */
    cursor: pointer;
    overflow: hidden;
    -webkit-tap-highlight-color: transparent;
  }

  :global(html.dark) .photo-tile-btn {
    background: #3b4252; /* nord1 */
  }

  .photo-tile-btn:focus-visible {
    outline: 2px solid #88c0d0; /* nord9 */
    outline-offset: 3px;
  }

  .photo-tile-btn img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  .photo-tile-overlay {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 2.5rem 1rem 1rem;
    background: linear-gradient(
      to top,
      rgba(46, 52, 64, 0.88) 0%,
      rgba(46, 52, 64, 0.45) 55%,
      transparent 100%
    );
    color: #eceff4; /* nord6 */
    text-align: left;
    opacity: 0;
    transform: translateY(0.4rem);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .photo-tile-btn:hover img,
    .photo-tile-btn:focus-visible img {
      transform: scale(1.04);
    }

    .photo-tile-btn:hover .photo-tile-overlay,
    .photo-tile-btn:focus-visible .photo-tile-overlay {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .photo-tile-btn.is-active .photo-tile-overlay {
    opacity: 1;
    transform: translateY(0);
  }

  .photo-tile-description {
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .photo-tile-location {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.78rem;
    color: #88c0d0; /* nord9 */
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-tile-btn img,
    .photo-tile-overlay {
      transition: none;
    }

    .photo-tile-btn:hover img,
    .photo-tile-btn:focus-visible img {
      transform: none;
    }
  }
</style>

<script>
  const tiles = document.querySelectorAll(".photo-tile-btn");
  const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

  if (!canHover) {
    tiles.forEach((tile) => {
      tile.addEventListener("click", () => {
        const isActive = tile.classList.toggle("is-active");
        tiles.forEach((other) => {
          if (other !== tile) other.classList.remove("is-active");
        });
        tile.setAttribute("aria-pressed", String(isActive));
      });
    });
  }
</script>
