---
import { photos } from "../data/photos";
import { MapPin } from "phosphor-react";

/** Stable-but-scattered tilts so cards don’t jump between builds. */
const tilts = [-7, 5, -3, 6, -5, 4, -6, 3, -2, 7, -4, 5];

const tiltedPhotos = photos.map((photo, index) => ({
  ...photo,
  tilt: tilts[index % tilts.length],
}));
---

{
  tiltedPhotos.length > 0 ? (
    <section class="photo-gallery" aria-label="Photos">
      <h2 class="photo-gallery-heading">Photos</h2>
      <ul class="photo-gallery-grid">
        {tiltedPhotos.map((photo) => (
          <li class="photo-card" style={`--tilt: ${photo.tilt}deg`}>
            <button
              type="button"
              class="photo-card-flip"
              aria-label={`${photo.alt}. ${photo.description}. ${photo.location}. Click or hover to flip.`}
            >
              <span class="photo-card-inner">
                <span class="photo-card-face photo-card-front">
                  <img src={photo.src} alt={photo.alt} loading="lazy" />
                </span>
                <span class="photo-card-face photo-card-back">
                  <span class="photo-card-back-body">
                    <span class="photo-card-description">{photo.description}</span>
                    <span class="photo-card-location">
                      <MapPin size={16} weight="fill" />
                      {photo.location}
                    </span>
                  </span>
                </span>
              </span>
            </button>
          </li>
        ))}
      </ul>
    </section>
  ) : null
}

<style>
  .photo-gallery {
    margin-top: 3rem;
    padding-top: 0.5rem;
  }

  .photo-gallery-heading {
    margin: 0 0 1.25rem;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #2e3440; /* nord0 */
  }

  :global(html.dark) .photo-gallery-heading {
    color: #eceff4; /* nord6 */
  }

  .photo-gallery-grid {
    list-style: none;
    margin: 0;
    padding: 0.75rem 0.25rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 480px) {
    .photo-gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .photo-gallery-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.25rem 1.75rem;
    }
  }

  .photo-card {
    perspective: 1000px;
    transform: rotate(var(--tilt, 0deg));
    transition: transform 0.25s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .photo-card:hover {
      transform: rotate(var(--tilt, 0deg)) scale(1.03);
      z-index: 2;
    }
  }

  .photo-card-flip {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    border-radius: 0.75rem;
    box-shadow: 0 8px 24px rgba(46, 52, 64, 0.18);
    -webkit-tap-highlight-color: transparent;
  }

  :global(html.dark) .photo-card-flip {
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.35);
  }

  .photo-card-flip:focus-visible {
    outline: 2px solid #88c0d0; /* nord9 */
    outline-offset: 3px;
  }

  .photo-card-inner {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.55s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .photo-card-flip:hover .photo-card-inner,
    .photo-card-flip:focus-visible .photo-card-inner {
      transform: rotateY(180deg);
    }
  }

  .photo-card-flip.is-flipped .photo-card-inner {
    transform: rotateY(180deg);
  }

  .photo-card-face {
    position: absolute;
    inset: 0;
    border-radius: 0.75rem;
    overflow: hidden;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .photo-card-front {
    background: #d8dee9; /* nord5 */
  }

  :global(html.dark) .photo-card-front {
    background: #3b4252; /* nord1 */
  }

  .photo-card-front img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo-card-back {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    transform: rotateY(180deg);
    background: #e5e9f0; /* nord4-ish light */
    color: #2e3440; /* nord0 */
  }

  :global(html.dark) .photo-card-back {
    background: #3b4252; /* nord1 */
    color: #eceff4; /* nord6 */
  }

  .photo-card-back-body {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    text-align: center;
  }

  .photo-card-description {
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .photo-card-location {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: #5e81ac; /* nord10 */
  }

  :global(html.dark) .photo-card-location {
    color: #88c0d0; /* nord9 */
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-card,
    .photo-card-inner {
      transition: none;
    }

    .photo-card {
      transform: none;
    }

    @media (hover: hover) and (pointer: fine) {
      .photo-card:hover {
        transform: none;
      }
    }
  }
</style>

<script>
  const cards = document.querySelectorAll(".photo-card-flip");
  const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

  if (!canHover) {
    cards.forEach((card) => {
      card.addEventListener("click", () => {
        const isFlipped = card.classList.toggle("is-flipped");
        cards.forEach((other) => {
          if (other !== card) other.classList.remove("is-flipped");
        });
        card.setAttribute("aria-pressed", String(isFlipped));
      });
    });
  }
</script>
