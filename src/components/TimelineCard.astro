---
import type { TimelineEvent, TimelineLink } from "../data/timeline";
import { GithubLogo, LinkedinLogo, Globe } from "phosphor-react";

export interface Props {
  event: TimelineEvent;
}

const { event } = Astro.props;

const hasLinks = (event.links?.length ?? 0) > 0;
const meta = `${event.dateRange} | ${event.category}`;
---

<article
  class:list={[
    "rounded-2xl border p-4 shadow transition",
    "bg-nord5/90 dark:bg-nord0/60",
    "text-nord0 dark:text-nord6",
    event.featured
      ? "border-nord9 shadow-md"
      : "border-nord3/40 dark:border-nord6/40",
    "hover:border-nord9 focus-within:border-nord9",
  ]}
>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <div class="text-sm font-mono text-nord10 dark:text-nord9">{meta}</div>
    </div>

    {
      hasLinks ? (
        <div class="flex shrink-0 items-center gap-2 text-nord0 dark:text-nord6">
          {event.links?.map((l: TimelineLink) => (
            <a
              href={l.href}
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors hover:text-nord9"
              aria-label={l.kind}
            >
              {l.kind === "github" ? (
                <GithubLogo size={18} weight="bold" />
              ) : l.kind === "linkedin" ? (
                <LinkedinLogo size={18} weight="bold" />
              ) : (
                <Globe size={18} weight="bold" />
              )}
            </a>
          ))}
        </div>
      ) : null
    }
  </div>

  <h3 class="mt-2 text-xl font-bold text-nord0 dark:text-nord6">{event.title}</h3>
  <p class="mt-2 text-nord0 dark:text-nord6">{event.description}</p>

  {event.highlight ? <p class="mt-3 font-semibold text-nord13">{event.highlight}</p> : null}
</article>

