---
import Layout from "../layouts/Layout.astro";
import Project from "../components/Project.astro";
import Timeline from "../components/Timeline.astro";
import {
  GithubLogo,
  LinkedinLogo,
  TwitterLogo,
  Envelope,
  File,
  MapPin,
} from "phosphor-react";
---

<Layout title="Stephen Purdue">
  <main class="pb-32">
    <section class="about-intro font-mono px-4 pt-10 pb-6 max-w-6xl mx-auto w-full">
      <div class="flex flex-col phone:flex-row items-center phone:items-start gap-5">
        <img
          src="/images/profile.jpg"
          alt="Stephen Purdue"
          class="w-28 h-28 rounded-full border-2 border-nord9 object-cover shrink-0"
        />
        <div class="flex flex-1 min-w-0 flex-col gap-1.5 text-nord0 dark:text-nord6 phone:text-left text-center">
          <h1 class="text-2xl font-bold text-nord9">
            <span
              class="typewriter"
              data-text="Hi, I'm Stephen"
              aria-label="Hi, I'm Stephen"
            ></span><span class="typewriter-cursor" aria-hidden="true"></span>
          </h1>
          <p class="flex items-center justify-center phone:justify-start gap-1 text-sm text-nord0 dark:text-nord6">
            <MapPin size={16} weight="fill" />
            Southampton, UK
          </p>
          <p class="about-bio text-nord0 dark:text-nord6">
            I've spent four years in Game Development with Unity and
            Unreal Engine, pursuing an MSc in AI, hoping to break into Software Engineering, and eventually Quant.
          </p>
          <div class="flex gap-4 mt-2 justify-center phone:justify-start text-nord0 dark:text-nord6">
            <a
              href="mailto:stephendpurdue@gmail.com"
              class="social-link transition-colors hover:text-nord9"
              aria-label="Email"
            >
              <Envelope size={22} weight="bold" />
            </a>
            <a
              href="https://x.com/stephendpurdue"
              target="_blank"
              rel="noopener noreferrer"
              class="social-link transition-colors hover:text-nord9"
              aria-label="Twitter"
            >
              <TwitterLogo size={22} weight="bold" />
            </a>
            <a
              href="https://github.com/stephendpurdue"
              target="_blank"
              rel="noopener noreferrer"
              class="social-link transition-colors hover:text-nord9"
              aria-label="GitHub"
            >
              <GithubLogo size={22} weight="bold" />
            </a>
            <a
              href="https://www.linkedin.com/in/stephenpurdue"
              target="_blank"
              rel="noopener noreferrer"
              class="social-link transition-colors hover:text-nord9"
              aria-label="LinkedIn"
            >
              <LinkedinLogo size={22} weight="bold" />
            </a>
            <a
              href="/documents/Stephen Purdue - CV.pdf"
              download="Stephen Purdue - CV.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="social-link transition-colors hover:text-nord9"
              aria-label="Resume"
            >
              <File size={22} weight="bold" />
            </a>
          </div>
        </div>
      </div>
    </section>
    <div class="flex justify-center gap-4 py-6 max-w-6xl mx-auto w-full px-4">
      <button
        data-target="timeline"
        class="px-4 py-2 rounded-full shadow shadow-transparent bg-nord9 text-white font-bold hover:bg-nord0 dark:hover:bg-nord6 hover:text-white dark:hover:text-nord0 hover:shadow-md hover:-translate-y-1 active:translate-y-0 active:shadow-transparent transition-all"
      >
        Timeline
      </button>
      <button
        data-target="projects"
        class="px-4 py-2 rounded-full shadow shadow-transparent bg-nord6 dark:bg-nord5 dark:text-nord0 text-nord0 font-bold hover:bg-nord6 dark:hover:bg-nord6 hover:text-nord0 dark:hover:text-nord0 hover:shadow-md hover:-translate-y-1 active:translate-y-0 active:shadow-transparent transition-all"
      >
        Projects
      </button>
    </div>
    <div data-name="timeline" class="mx-auto w-full max-w-6xl px-4">
      <Timeline />
    </div>
    <div
      data-name="projects"
      class="hidden px-4 mx-auto w-full max-w-6xl grid phone:grid-cols-2 tablet:grid-cols-3 laptop:grid-cols-4 gap-4"
    >
      <Project
        name="Expense Tracker"
        description="Budgeting tool created using Python and Pandas."
        icon="/images/piechart.svg"
        link="https://github.com/stephendpurdue/ExpenseTracker"
      />

      <Project
        name="Slackers"
        description="Vertical Slice created for third year Client Project, in collaboration with RaRa Games."
        icon="/images/controller.svg"
        link="https://github.com/stephendpurdue/Slackers"
      />

      <Project
        name="Synapse"
        description="Teaching machines to fight smarter through iterative failure."
        icon="/images/crosshair.svg"
        link="https://github.com/stephendpurdue/Synapse"
      />

      <Project
        name="Exodus"
        description="Procedurally generated dungeon crawler, created in Unity."
        icon="/images/sword.svg"
        link="https://github.com/stephendpurdue/Exodus"
      />
    </div>
  </main>

  <style>
    button[data-target] {
      background-color: #eceff4 !important; /* nord6 - light */
      color: #2e3440 !important; /* nord0 */
    }

    :global(html.dark) button[data-target] {
      background-color: #d8dee9 !important; /* nord5 - dark */
      color: #2e3440 !important; /* nord0 */
    }

    .about-intro .about-bio {
      font-size: 0.8125rem; /* ~13px, tighter than text-sm */
      line-height: 1.35;
    }

    @media (min-width: 480px) {
      .about-intro .about-bio {
        font-size: 0.875rem;
        line-height: 1.4;
      }
    }

    .about-intro a:not(.social-link) {
      color: #88c0d0; /* nord9 */
      text-decoration: underline;
    }

    .about-intro a:not(.social-link):hover {
      color: #5e81ac; /* nord10 */
    }

    .about-intro .social-link {
      background: transparent !important;
      color: #2e3440 !important; /* nord0 - light */
    }

    .about-intro .social-link:hover {
      color: #88c0d0 !important; /* nord9 */
    }

    :global(html.dark) .about-intro .social-link {
      color: #eceff4 !important; /* nord6 - dark */
    }

    :global(html.dark) .about-intro .social-link:hover {
      color: #88c0d0 !important; /* nord9 */
    }

    button[data-target].bg-nord9 {
      background-color: #88c0d0 !important; /* nord9 */
      color: #ffffff !important;
    }

    .typewriter-cursor {
      display: inline-block;
      width: 0.08em;
      height: 1.05em;
      margin-left: 0.12em;
      vertical-align: -0.12em;
      background-color: currentColor;
      animation: typewriter-blink 1s step-end infinite;
    }

    .typewriter-cursor.is-done {
      animation: none;
      opacity: 0;
      transition: opacity 0.4s ease;
    }

    @keyframes typewriter-blink {
      50% {
        opacity: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .typewriter-cursor {
        display: none;
      }
    }
  </style>

  <script type="module">
    const typewriter = document.querySelector(".typewriter");
    const cursor = document.querySelector(".typewriter-cursor");
    const fullText = typewriter?.getAttribute("data-text") ?? "";
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (typewriter) {
      if (prefersReducedMotion) {
        typewriter.textContent = fullText;
        cursor?.classList.add("is-done");
      } else {
        let index = 0;
        const typeNext = () => {
          if (index <= fullText.length) {
            typewriter.textContent = fullText.slice(0, index);
            index += 1;
            window.setTimeout(typeNext, index === 1 ? 280 : 72);
          } else {
            window.setTimeout(() => cursor?.classList.add("is-done"), 900);
          }
        };
        typeNext();
      }
    }

    const buttons = document.querySelectorAll("button[data-target]");

    let activeButton;
    let activeSection;

    const styles = {
      button: {
        active: ["bg-nord9", "text-white"],
        inactive: [
          "bg-nord6",
          "dark:bg-nord5",
          "text-nord0",
          "dark:text-nord0",
        ],
      },
    };

    const style = (element, { add = [], remove = [] }) => {
      for (const removed of remove) {
        element.classList.remove(removed);
      }

      for (const added of add) {
        element.classList.add(added);
      }
    };

    const transition = (target) => {
      const button = document.querySelector(`button[data-target="${target}"]`);
      const section = document.querySelector(`div[data-name="${target}"]`);

      if (!activeButton || !activeSection) {
        style(button, {
          add: styles.button.active,
          remove: styles.button.inactive,
        });

        section.classList.remove("hidden");

        activeButton = button;
        activeSection = section;
      } else {
        style(activeButton, {
          add: styles.button.inactive,
          remove: styles.button.active,
        });
        style(button, {
          add: styles.button.active,
          remove: styles.button.inactive,
        });

        activeSection.classList.add("hidden");
        section.classList.remove("hidden");

        activeButton = button;
        activeSection = section;
      }
    };

    const onButtonClick = (event) => {
      const target = event.target.getAttribute("data-target");
      transition(target);
    };

    for (const button of buttons) {
      button.addEventListener("click", onButtonClick);
    }

    transition("timeline");
  </script>
</Layout>
