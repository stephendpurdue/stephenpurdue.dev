                      <td class="px-4 py-2 text-white">Disguise System (Need)</td>
                      <td class="px-4 py-2">Core brief requirement.</td>
                      <td class="px-4 py-2"><span class="px-3 py-1 rounded-full bg-nord14 text-nord0 text-sm font-semibold">Completed</span></td>
                    </tr>
                    <tr class="border-b border-nord6/40">
                      <td class="px-4 py-2 text-white">Sabotage System (Need)</td>
                      <td class="px-4 py-2">Core brief requirement.</td>
                      <td class="px-4 py-2"><span class="px-3 py-1 rounded-full bg-nord13 text-nord0 text-sm font-semibold">On-Hold</span></td>
                    </tr>
                    <tr class="bg-nord3/20">
                      <td class="px-4 py-2 text-white">Tutorial System (Want)</td>
                      <td class="px-4 py-2">Critical to player accessibility, but not as important as core requirements.</td>
                      <td class="px-4 py-2"><span class="px-3 py-1 rounded-full bg-nord13 text-nord0 text-sm font-semibold">On-Hold</span></td>
                    </tr>
                  </tbody>
