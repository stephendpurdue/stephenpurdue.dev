---
import ThemeToggle from "../components/ThemeToggle.astro";

export interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark bg-nord6 dark:bg-nord1 min-h-screen">
	<head>
		<script is:inline>
			(function () {
				const theme = localStorage.getItem("theme");
				const isDark = theme !== "light";
				document.documentElement.classList.toggle("dark", isDark);
			})();
		</script>
		<style is:inline>
			html {
				background-color: #2e3440;
				color-scheme: dark;
			}
			html:not(.dark) {
				background-color: #eceff4;
				color-scheme: light;
			}
		</style>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Nunito:wght@300;400;700&display=swap"
			rel="stylesheet"
		/>
		<script
			defer
			data-domain="jakehamilton.dev,jakehamilton.website"
			src="https://plausible.io/js/plausible.js"
		></script>
	</head>
	<body class="font-sans text-base text-nord0 dark:text-nord6 bg-nord6 dark:bg-nord1 min-h-screen">
		<ThemeToggle />
		<slot />
	</body>
</html>
<style is:global>
	html,
	body {
		background-color: #eceff4 !important; /* nord6 - light */
	}

	html.dark,
	html.dark body {
		background-color: #2e3440 !important; /* nord0 - dark */
	}
</style>
